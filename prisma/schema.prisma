generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  DEVELOPER
  ADMIN
  SUPER_ADMIN
}

enum AstrologyReportType {
  VEDIC
  KP
  COMBINED
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ManagedScriptPlacement {
  HEAD
  BODY_START
  BODY_END
}

enum ManagedScriptAuditAction {
  CREATED
  UPDATED
  ENABLED
  DISABLED
  DELETED
}

enum ApiKeyStatus {
  ACTIVE
  DISABLED
  REVOKED
}

enum ApiProductStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  ACTIVE
  REJECTED
  INACTIVE
  SUSPENDED
}

enum ApiUsageWindowType {
  MINUTE
  DAY
  MONTH
}

enum ApiDeveloperProfileStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum ApiPlanStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ApiSubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
  SUSPENDED
}

enum ApiPaymentProvider {
  MOCK
}

enum ApiPaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUND_PENDING
  REFUNDED
  DISPUTED
}

enum ApiInvoiceStatus {
  ISSUED
  PAID
  VOID
  REFUNDED
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  fullName     String?
  passwordHash String
  role         UserRole     @default(USER)
  termsVersion String?
  termsAcceptedAt DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  profiles     BirthProfile[]
  charts       SavedChart[]
  sessions     Session[]
  approvals    VerificationApproval[]
  questions    KundliQuestion[]
  superAdminAccessLogs SuperAdminAccessLog[]
  passwordResetTokens PasswordResetToken[]
  blogPosts     BlogPost[]
  apiKeys       ApiKey[] @relation("ApiKeyOwner")
  createdApiKeys ApiKey[] @relation("ApiKeyCreator")
  apiAccessGrants ApiAccountGrant[] @relation("ApiGrantAccount")
  createdApiAccessGrants ApiAccountGrant[] @relation("ApiGrantActor")
  apiAdminPermissions ApiAdminPermission[] @relation("ApiAdminPermissionAdmin")
  grantedApiAdminPermissions ApiAdminPermission[] @relation("ApiAdminPermissionActor")
  apiKeyAuditLogs ApiKeyAuditLog[] @relation("ApiKeyAuditActor")
  apiPlatformAuditLogs ApiPlatformAuditLog[] @relation("ApiPlatformAuditActor")
  apiProducts ApiProduct[] @relation("ApiProductDeveloper")
  apiUsageWindows ApiAccountUsageWindow[]
  apiDeveloperProfile ApiDeveloperProfile?
  reviewedApiDeveloperProfiles ApiDeveloperProfile[] @relation("ApiDeveloperProfileReviewer")
  apiUsageEvents ApiUsageEvent[] @relation("ApiUsageDeveloper")
  apiPlansCreated ApiPlan[] @relation("ApiPlanCreator")
  apiPlansUpdated ApiPlan[] @relation("ApiPlanUpdater")
  apiSubscriptions ApiSubscription[]
  apiRefundActions ApiPayment[] @relation("ApiPaymentRefundActor")
  kundaliDocument KundaliDocument?
  astrologyReadings SavedAstrologyReading[]
  palmistryRecord     PalmistryRecord?
  palmistryHandImages PalmistryHandImage[]
  palmistryReadings   PalmistryReading[]
  seoPageSettings SeoPageSetting[]
  seoAuditHistory SeoAuditHistory[] @relation("SeoAuditActor")


}

model ApiProduct {
  id                    String @id @default(cuid())
  slug                  String @unique @db.VarChar(60)
  name                  String @db.VarChar(100)
  description           String @db.VarChar(500)
  developerUserId       String?
  category              String? @db.VarChar(60)
  pricingModel          String? @db.VarChar(80)
  endpoints             String[] @default([])
  defaultRequestsPerMinute Int @default(30)
  defaultDailyQuota     Int @default(1000)
  defaultMonthlyQuota   Int @default(30000)
  enabled               Boolean @default(true)
  status                ApiProductStatus @default(ACTIVE)
  rejectionReason       String? @db.VarChar(1000)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  developer             User? @relation("ApiProductDeveloper", fields: [developerUserId], references: [id], onDelete: SetNull)
  accountGrants         ApiAccountGrant[]
  adminPermissions      ApiAdminPermission[]
  apiKeys               ApiKey[]
  accountUsageWindows  ApiAccountUsageWindow[]
  usageEvents          ApiUsageEvent[]
  planProducts         ApiPlanProduct[]

  @@index([enabled, name])
  @@index([developerUserId, status])
  @@index([status, createdAt])
}

model ApiAccountGrant {
  id                    String @id @default(cuid())
  accountUserId         String
  productId             String
  scopes                String[] @default([])
  requestsPerMinute     Int
  dailyQuota            Int
  monthlyQuota          Int
  enabled               Boolean @default(true)
  grantedByUserId       String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  account               User @relation("ApiGrantAccount", fields: [accountUserId], references: [id], onDelete: Cascade)
  product               ApiProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  grantedBy             User @relation("ApiGrantActor", fields: [grantedByUserId], references: [id], onDelete: Restrict)
  apiKeys               ApiKey[]

  @@unique([accountUserId, productId])
  @@index([productId, enabled])
}

model ApiAdminPermission {
  id                    String @id @default(cuid())
  adminUserId           String
  productId             String
  scopes                String[] @default([])
  maxRequestsPerMinute  Int
  maxDailyQuota         Int
  maxMonthlyQuota       Int
  canManageAccess       Boolean @default(false)
  enabled               Boolean @default(true)
  grantedByUserId       String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  admin                 User @relation("ApiAdminPermissionAdmin", fields: [adminUserId], references: [id], onDelete: Cascade)
  product               ApiProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  grantedBy             User @relation("ApiAdminPermissionActor", fields: [grantedByUserId], references: [id], onDelete: Restrict)

  @@unique([adminUserId, productId])
  @@index([productId, enabled])
}

model ApiKey {
  id                    String @id @default(cuid())
  keyId                 String @unique @db.VarChar(24)
  digest                String @unique @db.VarChar(64)
  prefix                String @db.VarChar(32)
  label                 String @db.VarChar(100)
  ownerUserId           String
  createdByUserId       String
  productId             String
  accountGrantId        String
  scopes                String[] @default([])
  requestsPerMinute     Int
  dailyQuota            Int
  monthlyQuota          Int
  status                ApiKeyStatus @default(ACTIVE)
  expiresAt             DateTime?
  lastUsedAt            DateTime?
  rotatedToId           String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  owner                 User @relation("ApiKeyOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  createdBy             User @relation("ApiKeyCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  product               ApiProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  accountGrant          ApiAccountGrant @relation(fields: [accountGrantId], references: [id], onDelete: Restrict)
  usageWindows          ApiKeyUsageWindow[]
  auditLogs             ApiKeyAuditLog[]
  usageEvents           ApiUsageEvent[]

  @@index([ownerUserId, status])
  @@index([productId, status])
  @@index([expiresAt])
  @@unique([ownerUserId, label])
}

model ApiKeyUsageWindow {
  id          String @id @default(cuid())
  apiKeyId    String
  windowType  ApiUsageWindowType
  windowStart DateTime
  requestCount Int @default(0)
  errorCount  Int @default(0)
  updatedAt   DateTime @updatedAt
  apiKey      ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@unique([apiKeyId, windowType, windowStart])
  @@index([apiKeyId, windowStart])
}

model ApiAccountUsageWindow {
  id           String @id @default(cuid())
  accountUserId String
  productId    String
  windowType   ApiUsageWindowType
  windowStart  DateTime
  requestCount Int @default(0)
  errorCount   Int @default(0)
  updatedAt    DateTime @updatedAt
  account      User @relation(fields: [accountUserId], references: [id], onDelete: Cascade)
  product      ApiProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([accountUserId, productId, windowType, windowStart])
  @@index([accountUserId, productId, windowStart])
}

model ApiDeveloperProfile {
  userId           String @id
  status           ApiDeveloperProfileStatus @default(PENDING)
  grandfathered    Boolean @default(false)
  organizationName String? @db.VarChar(160)
  website          String? @db.VarChar(2048)
  supportEmail     String? @db.VarChar(254)
  description      String? @db.VarChar(2000)
  applicationReason String? @db.VarChar(1000)
  rejectionReason  String? @db.VarChar(1000)
  submittedAt      DateTime @default(now())
  reviewedAt       DateTime?
  reviewedByUserId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy       User? @relation("ApiDeveloperProfileReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([status, submittedAt])
  @@index([reviewedByUserId, reviewedAt])
}

model ApiPlan {
  id                    String @id @default(cuid())
  slug                  String @unique @db.VarChar(60)
  name                  String @db.VarChar(100)
  description           String @db.VarChar(1000)
  status                ApiPlanStatus @default(DRAFT)
  priceMinorUnits       BigInt?
  currency              String? @db.VarChar(3)
  taxRateBasisPoints    Int?
  periodDays            Int?
  createdByUserId       String
  updatedByUserId       String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  createdBy             User @relation("ApiPlanCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy             User @relation("ApiPlanUpdater", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  products              ApiPlanProduct[]
  subscriptions         ApiSubscription[]
  usageEvents           ApiUsageEvent[]

  @@index([status, createdAt])
}

model ApiPlanProduct {
  id                    String @id @default(cuid())
  planId                String
  productId             String
  requestsPerMinute     Int
  dailyQuota            Int
  monthlyQuota          Int
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  plan                  ApiPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  product               ApiProduct @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([planId, productId])
  @@index([productId, planId])
}

model ApiSubscription {
  id                    String @id @default(cuid())
  idempotencyKey        String @unique @db.VarChar(120)
  developerUserId       String
  planId                String
  status                ApiSubscriptionStatus @default(PENDING)
  currentPeriodStart    DateTime?
  currentPeriodEnd      DateTime?
  cancelAtPeriodEnd     Boolean @default(false)
  priceMinorUnits       BigInt?
  currency              String? @db.VarChar(3)
  taxRateBasisPoints    Int?
  periodDays            Int?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  developer             User @relation(fields: [developerUserId], references: [id], onDelete: Cascade)
  plan                  ApiPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments              ApiPayment[]
  invoices              ApiInvoice[]

  @@index([developerUserId, status, createdAt])
  @@index([status, currentPeriodEnd])
  @@index([planId, status])
}

model ApiPayment {
  id                       String @id @default(cuid())
  subscriptionId           String
  provider                 ApiPaymentProvider @default(MOCK)
  status                   ApiPaymentStatus @default(PENDING)
  amountMinorUnits         BigInt
  currency                 String @db.VarChar(3)
  isSandbox                Boolean @default(true)
  idempotencyKey           String @unique @db.VarChar(120)
  providerReference        String? @unique @db.VarChar(200)
  failureCode              String? @db.VarChar(80)
  refundedAmountMinorUnits BigInt @default(0)
  refundReason             String? @db.VarChar(1000)
  refundRequestedByUserId   String?
  refundConfirmedAt        DateTime?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  subscription             ApiSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  refundRequestedBy        User? @relation("ApiPaymentRefundActor", fields: [refundRequestedByUserId], references: [id], onDelete: SetNull)
  invoice                  ApiInvoice?

  @@index([subscriptionId, createdAt])
  @@index([status, createdAt])
  @@index([isSandbox, status, createdAt])
}

model ApiInvoice {
  id                   String @id @default(cuid())
  invoiceNumber        String @unique @db.VarChar(40)
  subscriptionId       String
  paymentId            String? @unique
  status               ApiInvoiceStatus @default(ISSUED)
  subtotalMinorUnits   BigInt
  taxMinorUnits        BigInt
  totalMinorUnits      BigInt
  currency             String @db.VarChar(3)
  issuedAt             DateTime @default(now())
  billingSnapshot      Json
  subscription         ApiSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  payment              ApiPayment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([subscriptionId, issuedAt])
  @@index([status, issuedAt])
}

model ApiProviderEvent {
  id                String @id @default(cuid())
  provider          ApiPaymentProvider
  providerEventId   String @db.VarChar(200)
  eventType         String @db.VarChar(100)
  payloadHash       String @db.VarChar(64)
  outcome           String @db.VarChar(100)
  processedAt       DateTime @default(now())

  @@unique([provider, providerEventId])
  @@index([processedAt, provider])
}

model ApiUsageEvent {
  id               String @id @default(cuid())
  requestId        String @unique @db.VarChar(36)
  apiKeyId         String
  developerUserId  String
  productId        String
  planId           String?
  endpoint         String @db.VarChar(120)
  statusCode       Int
  responseTimeMs   Int
  occurredAt       DateTime @default(now())
  apiKey           ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  developer        User @relation("ApiUsageDeveloper", fields: [developerUserId], references: [id], onDelete: Cascade)
  product          ApiProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  plan             ApiPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([developerUserId, occurredAt])
  @@index([productId, occurredAt])
  @@index([endpoint, occurredAt])
  @@index([statusCode, occurredAt])
  @@index([planId, occurredAt])
}

model ApiKeyAuditLog {
  id          String @id @default(cuid())
  apiKeyId    String
  actorUserId String
  action      String @db.VarChar(30)
  details     Json
  createdAt   DateTime @default(now())
  apiKey      ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  actor       User @relation("ApiKeyAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([apiKeyId, createdAt])
  @@index([actorUserId, createdAt])
}

model ApiPlatformAuditLog {
  id          String @id @default(cuid())
  actorUserId String
  action      String @db.VarChar(40)
  targetType  String @db.VarChar(40)
  targetId    String @db.VarChar(120)
  details     Json
  createdAt   DateTime @default(now())
  actor       User @relation("ApiPlatformAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([targetType, targetId, createdAt])
  @@index([actorUserId, createdAt])
}

model ManagedScript {
  id              String                 @id @default(cuid())
  name            String                 @db.VarChar(100)
  snippet         String
  placement       ManagedScriptPlacement
  enabled         Boolean                @default(false)
  targetPaths     String[]               @default([])
  createdByUserId String
  updatedByUserId String
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([enabled, placement])
  @@index([updatedAt])
}

model ManagedScriptAuditLog {
  id          String                  @id @default(cuid())
  scriptId    String
  scriptName  String                  @db.VarChar(100)
  actorUserId String
  action      ManagedScriptAuditAction
  createdAt   DateTime                @default(now())

  @@index([scriptId, createdAt])
  @@index([actorUserId, createdAt])
}

model BlogPost {
  id                  String         @id @default(cuid())
  title               String         @db.VarChar(160)
  slug                String         @unique @db.VarChar(180)
  excerpt             String         @db.VarChar(320)
  body                String
  featuredImageUrl    String?        @db.VarChar(2048)
  featuredImageAlt    String?
  authorName          String         @db.VarChar(100)
  category            String?        @db.VarChar(80)
  tags                String[]       @default([])
  status              BlogPostStatus @default(DRAFT)
  seoTitle            String?        @db.VarChar(70)
  seoDescription      String?        @db.VarChar(160)
  canonicalUrl        String?        @db.VarChar(2048)
  robotsIndex         Boolean        @default(true)
  publishedAt         DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  author              User           @relation(fields: [authorId], references: [id], onDelete: Restrict)
  authorId            String

  @@index([status, publishedAt])
  @@index([category, status, publishedAt])
  @@index([updatedAt])
}

model SeoPageSetting {
  path            String   @id @db.VarChar(180)
  settings        Json
  updatedByUserId String
  updatedAt       DateTime @updatedAt
  updatedBy       User     @relation(fields: [updatedByUserId], references: [id], onDelete: Restrict)

  @@index([updatedAt])
}

model SeoAuditHistory {
  id           String   @id @db.VarChar(100)
  completedAt  DateTime
  pagesAudited Int
  record       Json
  actorUserId  String
  actor        User     @relation("SeoAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([completedAt, id])
  @@index([actorUserId, completedAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  usedAt    DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model VerificationApproval {
  id            String   @id @default(cuid())
  requirementId String
  userId        String
  note          String?
  approvedAt    DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([requirementId, userId])
  @@index([userId, approvedAt])
}

model BirthProfile {
  id          String      @id @default(cuid())
  userId      String
  label       String
  birthPlace  String?
  localDate   String
  localTime   String?
  timeZone    String?
  latitude    Float?
  longitude   Float?
  birthTimeAccuracy String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  charts      SavedChart[]
  questions   KundliQuestion[]

  @@index([userId, updatedAt])
}

model SavedChart {
  id               String             @id @default(cuid())
  userId           String
  profileId        String?
  title            String
  reportType       AstrologyReportType @default(VEDIC)
  availableChartCount Int              @default(0)
  divisionalChartCount Int              @default(0)
  engineVersion    String
  ephemerisManifest String
  ruleSetVersion   String
  settings         Json
  inputSnapshot    Json
  result           Json
  resultHash       String
  createdAt        DateTime           @default(now())
  lastViewedAt     DateTime?
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile          BirthProfile?      @relation(fields: [profileId], references: [id], onDelete: SetNull)
  questions        KundliQuestion[]

  @@index([userId, createdAt])
  @@index([userId, reportType, createdAt])
  @@index([userId, lastViewedAt])
  @@index([resultHash])
}

model KundliQuestion {
  id              String       @id @default(cuid())
  userId          String
  profileId       String?
  savedChartId    String?
  requestId       String
  question        String       @db.VarChar(500)
  questionId      String?
  topic           String?
  sectionKey      String?      @db.VarChar(60)
  sectionLabel    String?      @db.VarChar(100)
  answer          Json
  answerStatus    String
  chartResultHash String
  createdAt       DateTime     @default(now())
  answeredAt      DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile         BirthProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  savedChart      SavedChart?  @relation(fields: [savedChartId], references: [id], onDelete: SetNull)

  @@unique([userId, requestId])
  @@index([userId, createdAt])
  @@index([userId, topic, createdAt])
  @@index([userId, savedChartId, sectionKey, createdAt])
}

model SavedAstrologyReading {
  id        String   @id @default(cuid())
  userId    String
  service   String   @db.VarChar(32)
  title     String   @db.VarChar(120)
  payload   Json
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, service, createdAt])
}

enum KundaliProcessingStatus {
  MANUAL_REVIEW_REQUIRED
}

enum PalmistryHandSide {
  LEFT
  RIGHT
}

model KundaliDocument {
  id                 String                  @id
  userId             String
  contentType        String                  @db.VarChar(32)
  fileExtension      String                  @db.VarChar(8)
  fileSizeBytes      Int
  processingStatus   KundaliProcessingStatus @default(MANUAL_REVIEW_REQUIRED)
  originalFile       Bytes
  uploadedAt         DateTime                @default(now())
  user               User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
}

model PalmistryRecord {
  id            String   @id
  userId        String   @unique
  contentType   String?  @db.VarChar(32)
  fileExtension String?  @db.VarChar(8)
  fileSizeBytes Int?
  originalFile  Bytes?
  observations  Json
  uploadedAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([updatedAt])
}

model PalmistryHandImage {
  id            String            @id
  userId        String
  handSide      PalmistryHandSide
  contentType   String            @db.VarChar(32)
  fileExtension String            @db.VarChar(8)
  fileSizeBytes Int
  originalFile  Bytes
  uploadedAt    DateTime          @default(now())
  updatedAt     DateTime          @default(now()) @updatedAt
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, handSide])
  @@index([updatedAt])
}

model PalmistryReading {
  id            String   @id
  userId        String
  title         String   @db.VarChar(120)
  observations  Json
  report        Json
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

enum SuperAdminAccessAction {
  USER_LIST_READ
  USER_FILTERED_READ
  USER_ROLE_CHANGED
  BOOTSTRAP_SUPER_ADMIN
  KUNDALI_REPORT_LIST_READ
  KUNDALI_REPORT_DETAIL_READ
}

model SuperAdminAccessLog {
  id          String                   @id @default(cuid())
  actorUserId String?
  actorLabel  String?
  action      SuperAdminAccessAction
  page        Int
  resultCount Int
  targetUserId String?
  fromRole    UserRole?
  toRole      UserRole?
  createdAt   DateTime                 @default(now())
  actor       User?                    @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([actorUserId, createdAt])
  @@index([createdAt])
}

model ChecklistRequirementDefinition {
  version       String
  requirementId String
  sectionId     String
  title         String
  definition    Json
  createdAt     DateTime @default(now())

  @@id([version, requirementId])
}

model VerificationRun {
  id          String @id
  version     String
  environment String
  status      String
  startedAt   DateTime
  completedAt DateTime?
  report      Json
  evidences   VerificationEvidence[]

  @@index([version, completedAt])
}

model VerificationEvidence {
  id                String   @id @default(cuid())
  runId             String
  requirementId     String
  status            String
  implementationStatus String
  testExecutionStatus  String
  method            String
  actualResult      String
  evidenceReference String?
  testedAt          DateTime?
  details           String?
  remediation       String?
  run               VerificationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, requirementId])
  @@index([requirementId, testedAt])
}

model VerificationStatusHistory {
  id            String   @id @default(cuid())
  requirementId String
  runId         String?
  fromStatus    String?
  toStatus      String
  source        String
  changedAt     DateTime @default(now())

  @@index([requirementId, changedAt])
}

model VerificationAcknowledgement {
  id             String   @id @default(cuid())
  requirementId  String
  reviewer       String
  note           String?
  acknowledgedAt DateTime @default(now())

  @@unique([requirementId, reviewer])
  @@index([acknowledgedAt])
}
